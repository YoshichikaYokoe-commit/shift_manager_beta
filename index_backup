    // 月間カレンダー表示
    function renderCalendar() {
      calendarGrid.innerHTML = "";
      calendarTitle.textContent = `${calendarYear}年${calendarMonth + 1}月`;
      syncSalaryMonthInput();

      const weekdays = ["日", "月", "火", "水", "木", "金", "土"];

      weekdays.forEach((weekday, index) => {
        const header = document.createElement("div");
        header.className = "calendar-weekday";

        if (index === 0) header.classList.add("sunday");
        if (index === 6) header.classList.add("saturday");

        header.textContent = weekday;
        calendarGrid.appendChild(header);
      });

      const firstDay = new Date(calendarYear, calendarMonth, 1);
      const firstWeekday = firstDay.getDay();
      const daysInMonth = new Date(calendarYear, calendarMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(calendarYear, calendarMonth, 0).getDate();

      // 必ず6週間表示（42マス）
      for (let cellIndex = 0; cellIndex < 42; cellIndex++) {
        let year = calendarYear;
        let month = calendarMonth;
        let dayNumber;
        let isOtherMonth = false;

        if (cellIndex < firstWeekday) {
          dayNumber = daysInPrevMonth - firstWeekday + cellIndex + 1;
          month--;
          isOtherMonth = true;

          if (month < 0) {
            month = 11;
            year--;
          }
        } else if (cellIndex >= firstWeekday + daysInMonth) {
          dayNumber = cellIndex - (firstWeekday + daysInMonth) + 1;
          month++;
          isOtherMonth = true;

          if (month > 11) {
            month = 0;
            year++;
          }
        } else {
          dayNumber = cellIndex - firstWeekday + 1;
        }

        const dayCell = document.createElement("div");
        dayCell.className = "calendar-day";

        if (isOtherMonth) {
          dayCell.classList.add("other-month");
        }

        const dateString = toDateString(year, month, dayNumber);
        const todayString = toDateString(
          now.getFullYear(),
          now.getMonth(),
          now.getDate()
        );

        if (dateString === todayString) {
          dayCell.classList.add("today");
        }

        const dateNumber = document.createElement("div");
        dateNumber.className = "calendar-date-number";
        dateNumber.textContent = dayNumber;
        dayCell.appendChild(dateNumber);

        const dayShifts = currentShifts.filter(
          (shift) => shift.date === dateString
        );

        dayShifts.forEach((shift) => {
          const shiftButton = document.createElement("button");
          shiftButton.className = "calendar-shift";
          shiftButton.dataset.id = shift.id;

          const shiftStatus = normalizeStatus(shift.status);

          shiftButton.innerHTML = `
            <span class="calendar-time">
              ${shift.startTime}-${shift.endTime}
            </span><br>
            ${shift.teacherName}<br>
            ${shift.studentName || "未設定"}<br>
            <span class="calendar-status">
              ${getStatusLabel(shiftStatus)}
            </span>
          `;

          shiftButton.addEventListener("click", (event) => {
            event.stopPropagation();
            startEdit(shift.id);
          });

          dayCell.appendChild(shiftButton);
        });

        // 日付の空いている場所をクリックしたらその日を入力欄へ入れる
        dayCell.addEventListener("click", () => {
          if (isOtherMonth) {
            calendarYear = year;
            calendarMonth = month;
            renderCalendar();
          }

          if (!editingShiftId) {
            shiftDate.value = dateString;
            activateTab("shift");

            setTimeout(() => {
              shiftFormArea.scrollIntoView({
                behavior: "smooth",
                block: "start"
              });
            }, 50);
          }
        });

        calendarGrid.appendChild(dayCell);
      }

      renderSalarySummary();
    }

