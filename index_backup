      document.querySelectorAll(".editButton").forEach((button) => {
        button.addEventListener("click", () => {
          startEdit(button.dataset.id);
        });
      });

      document.querySelectorAll(".deleteButton").forEach((button) => {
        button.addEventListener("click", async () => {
          const shiftId = button.dataset.id;
          const shift = currentShifts.find((item) => item.id === shiftId);

          if (!shift) {
            message.textContent = "削除するシフトが見つかりませんでした。";
            return;
          }

          const status = normalizeStatus(shift.status);

          // まず全シフト共通の確認
          const firstConfirm = confirm(
            "このシフトを削除しますか？\n\n" +
            `講師：${shift.teacherName || "未設定"}\n` +
            `生徒：${shift.studentName || "未設定"}\n` +
            `日時：${formatDate(shift.date)} ${shift.startTime || ""}～${shift.endTime || ""}\n` +
            `状態：${getStatusLabel(status)}\n\n` +
            "※ 授業の中止なら、削除せず「キャンセル」にしてください。"
          );

          if (!firstConfirm) {
            return;
          }

          // 「実施済み」だけは給与履歴に影響するので追加ロック
          if (status === "completed") {
            const secondConfirm = confirm(
              "【注意】このシフトは「実施済み」です。\n\n" +
              "削除すると、この授業が月別の給与計算から消え、\n" +
              "過去の給与集計額も変わります。\n\n" +
              "本当に削除しますか？"
            );

            if (!secondConfirm) {
              message.textContent = "実施済みシフトの削除をキャンセルしました。";
              clearMessageLater();
              return;
            }

            const typed = prompt(
              "実施済みシフトを削除するには、\n" +
              "「実施済み削除」\n" +
              "と入力してください。"
            );

            if (typed !== "実施済み削除") {
              message.textContent = "実施済みシフトの削除をキャンセルしました。";
              clearMessageLater();
              return;
            }
          }

          try {
            await deleteDoc(doc(db, "shifts", shiftId));

            if (editingShiftId === shiftId) {
              resetForm();
            }

            message.textContent =
              status === "completed"
                ? "実施済みシフトを削除しました。給与集計も更新されます。"
                : "シフトを削除しました。";

            clearMessageLater();

          } catch (error) {
            console.error(error);
            message.textContent = "シフトを削除できませんでした。";
          }
        });
      });
    }

