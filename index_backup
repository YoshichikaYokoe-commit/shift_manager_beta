    // 給与集計
    function renderSalarySummary() {
      const targetPrefix =
        salaryMonthInput.value ||
        `${calendarYear}-${String(calendarMonth + 1).padStart(2, "0")}`;

      const [targetYear, targetMonth] = targetPrefix.split("-").map(Number);

      salaryTitle.textContent =
        `給与集計（${targetYear}年${targetMonth}月）`;

      const teachers = currentTeachers;

      const monthlyShifts = currentShifts.filter((shift) =>
        (shift.date || "").startsWith(targetPrefix)
      );

      // 給与対象は「実施済み」のみ。
      // status未設定の既存データは「予定（未定）」扱いなので給与には入りません。
      const completedMonthlyShifts = monthlyShifts.filter(
        (shift) => normalizeStatus(shift.status) === "completed"
      );

      salarySummary.innerHTML = "";

      let grandMinutes = 0;
      let grandSalary = 0;
      let grandCount = 0;

      teachers.forEach((teacher) => {
        const allTeacherShifts = monthlyShifts.filter(
          (shift) => shift.teacherId === teacher.id
        );

        const teacherShifts = completedMonthlyShifts.filter(
          (shift) => shift.teacherId === teacher.id
        );

        const statusCounts = {
          tentative: 0,
          confirmed: 0,
          completed: 0,
          cancelled: 0
        };

        allTeacherShifts.forEach((shift) => {
          statusCounts[normalizeStatus(shift.status)]++;
        });

        const totalMinutes = teacherShifts.reduce(
          (sum, shift) => sum + getShiftMinutes(shift.startTime, shift.endTime),
          0
        );

        const rate = Number(teacher.hourlyRate) || 0;
        const salary = Math.round((totalMinutes / 60) * rate);

        grandMinutes += totalMinutes;
        grandSalary += salary;
        grandCount += teacherShifts.length;

        const card = document.createElement("div");
        card.className = "salary-summary-card";
        card.innerHTML = `
          <h3>${teacher.name}</h3>
          <p>予定（未定）：${statusCounts.tentative}件</p>
          <p>予定（確定）：${statusCounts.confirmed}件</p>
          <p>実施済み：${statusCounts.completed}件</p>
          <p>キャンセル：${statusCounts.cancelled}件</p>
          <p>給与対象時間：${formatHours(totalMinutes)}</p>
          <p>時給：${formatYen(rate)}</p>
          <p class="salary-amount">確定給与：${formatYen(salary)}</p>
        `;
        salarySummary.appendChild(card);
      });

      salaryTotal.innerHTML = `
        実施済み合計：${grandCount}件 ／ ${formatHours(grandMinutes)} ／ 確定給与 ${formatYen(grandSalary)}
      `;
    }

    function normalizeStatus(status) {
      const validStatuses = ["tentative", "confirmed", "completed", "cancelled"];
      return validStatuses.includes(status) ? status : "tentative";
    }

    function getStatusLabel(status) {
      const labels = {
        tentative: "予定（未定）",
        confirmed: "予定（確定）",
        completed: "実施済み",
        cancelled: "キャンセル"
      };

      return labels[normalizeStatus(status)];
    }

    function getStatusClass(status) {
      return `status-${normalizeStatus(status)}`;
    }

    function getShiftMinutes(start, end) {
      if (!start || !end) return 0;

      const [startHour, startMinute] = start.split(":").map(Number);
      const [endHour, endMinute] = end.split(":").map(Number);

      const startTotal = startHour * 60 + startMinute;
      const endTotal = endHour * 60 + endMinute;

      return Math.max(0, endTotal - startTotal);
    }

    function formatHours(minutes) {
      const hours = minutes / 60;
      return `${Number.isInteger(hours) ? hours : hours.toFixed(2)}時間`;
    }

    function formatYen(value) {
      return `${Math.round(Number(value) || 0).toLocaleString("ja-JP")}円`;
    }

    function sanitizeRate(value) {
      const number = Number(value);
      return Number.isFinite(number) && number >= 0 ? number : 0;
    }


    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function formatDate(dateString) {
      if (!dateString) {
        return "日付未設定";
      }

      const date = new Date(`${dateString}T00:00:00`);

      return date.toLocaleDateString(
        "ja-JP",
        {
          year: "numeric",
          month: "long",
          day: "numeric",
          weekday: "short"
        }
      );
    }

    function toDateString(year, month, day) {
      const yyyy = String(year).padStart(4, "0");
      const mm = String(month + 1).padStart(2, "0");
      const dd = String(day).padStart(2, "0");
      return `${yyyy}-${mm}-${dd}`;
    }
  </script>
</body>
